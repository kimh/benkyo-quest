# Supabase の接続文字列（Project Settings > Database > Connection string > Transaction pooler, ポート6543）
# マイグレーション(drizzle-kit)は Session pooler(5432) でも可
DATABASE_URL=
# Anthropic API キー
ANTHROPIC_API_KEY=
# 家族用パスコード（最初に端末で入力する合言葉）
FAMILY_PASSCODE=
# 保護者画面のPIN
PARENT_PIN=
# Cookie署名用のランダムな文字列（openssl rand -hex 32）
SESSION_SECRET=
